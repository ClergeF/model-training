# ─────────────────────────────────────────────────────────────────────────────
# CIC Knowledge Score Dataset — Environment Variables
#
# HOW TO USE:
#   1. Copy this file and rename the copy to just:  .env
#   2. Replace the placeholder values with your real keys.
#   3. Never commit your .env file to git — only commit this .env.example file.
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter API key — used by check_dataset.py for score sanity checking.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional — model used by check_dataset.py and check_skill_dataset.py
# OPENROUTER_MODEL=openrouter/owl-alpha
