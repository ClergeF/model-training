# ─────────────────────────────────────────────────────────────────────────────
# Story Chunking Dataset Generator — Environment Variables
#
# HOW TO USE:
#   1. Copy this file to:  .env
#   2. Set GENERATOR_PROVIDER and the API key for your chosen provider.
#   3. Never commit your .env file — only commit this .env.example.
# ─────────────────────────────────────────────────────────────────────────────

# Which provider generates the synthetic data:
# ollama, anthropic, openrouter, or transformers (V2 default)
GENERATOR_PROVIDER=transformers

# Hugging Face Transformers (V2 GPU generation on Colab/local CUDA)
# Accept the Llama license at huggingface.co, then:
#   huggingface-cli login
# or set HF_TOKEN below.
TRANSFORMERS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
HF_TOKEN=your_huggingface_token_here

# Local Ollama settings (used when GENERATOR_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Legacy alias (optional): full generate URL; OLLAMA_BASE_URL is preferred.
# OLLAMA_URL=http://localhost:11434/api/generate

# Anthropic settings (used when GENERATOR_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenRouter settings (used when GENERATOR_PROVIDER=openrouter)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
