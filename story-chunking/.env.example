# Recall AI API key — used by scripts/sync_recall_transcripts.py
# Get your key from the Recall AI dashboard.
# Copy this file to .env and replace the placeholder.
RECALL_API_KEY=your_recall_api_key_here

# Optional — override the Recall API region/base URL (default: us-east-1)
# RECALL_API_BASE_URL=https://us-west-2.recall.ai

# Optional — local Hugging Face token (Colab: use huggingface-cli login instead)
# HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here
